{
  "name": "eggeo-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "media": "bash scripts/media/build-media.sh",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "og": "node scripts/media/build-og.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "gh-pages": "^6.3.0",
    "vite": "^5.0.0"
  }
}
